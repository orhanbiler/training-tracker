# ─────────────────────────────────────────────────────────────
# Firebase Web SDK config
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` (ignored by git) and fill in the
# values from Firebase Console → ⚙ Project settings → General →
# Your apps → Web app → SDK setup and configuration.
#
# In Vercel, add these under Settings → Environment Variables and
# enable them for Production, Preview, and Development.
#
# All six are NEXT_PUBLIC_* because the Firebase Web SDK runs in
# the browser. That's expected — security lives in Firestore rules
# and Firebase Auth, not in hiding these values. Do NOT put any
# server-only secret behind a NEXT_PUBLIC_ prefix.
#
# If any of these are missing the app falls back to DEMO mode with
# the seed dataset in src/lib/mock-data.ts, so you can deploy and
# preview before the backend is wired up.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
